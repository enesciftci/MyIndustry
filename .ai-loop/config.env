# AI Loop guardrails — MyIndustry backend
# Agents and scripts may source this file. Adjust carefully.

MAX_ITERATIONS=5
MAX_RETRIES_PER_TEST=3
MAX_EXECUTION_TIME_MINUTES=45
MAX_CHANGED_FILES=40
COMMAND_TIMEOUT_SECONDS=900

# Backend has no Playwright; kept for cross-repo consistency
VERIFY_E2E=0
VERIFY_AUDIT_STRICT=0
