#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TASK_ID=""
TASK=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task-id) TASK_ID="$2"; shift 2 ;;
    --task) TASK="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$TASK_ID" ]]; then
  echo "Usage: $0 --task-id <id> [--task \"summary\"]" >&2
  exit 2
fi

STATE_DIR="$ROOT/.ai-loop/state"
mkdir -p "$STATE_DIR"
STATE_FILE="$STATE_DIR/${TASK_ID}.json"
STARTED="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

python3 - "$STATE_FILE" "$TASK_ID" "$TASK" "$STARTED" <<'PY'
import json, sys
path, task_id, task, started = sys.argv[1:5]
data = {
    "task": task or "",
    "task_id": task_id,
    "iteration": 0,
    "status": "in_progress",
    "started_at": started,
    "ended_at": "",
    "changes": [],
    "tests": [],
    "failures": [],
    "attempts": [],
    "commands": [],
    "next_action": "analyze",
    "final_status": "",
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
print(path)
PY
